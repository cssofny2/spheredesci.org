{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/about/",
        "http://localhost:4173/vl/",
        "http://localhost:4173/research/",
        "http://localhost:4173/research/uncertainty-budget-for-resonance/",
        "http://localhost:4173/research/archive/",
        "http://localhost:4173/research/category/measurement-methods/",
        "http://localhost:4173/research/authors/project-sphere/",
        "http://localhost:4173/knowledge/",
        "http://localhost:4173/glossary/",
        "http://localhost:4173/search/"
      ],
      "numberOfRuns": 2,
      "startServerCommand": "npx --yes serve@14.2.4 . -l 4173 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "interaction-to-next-paint": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

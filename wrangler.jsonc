{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spheredesci-org",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-30",
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spheredesci-vote",
      "database_id": "04d33239-4c26-4664-ae4b-253a73bb8dd4",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "REMIX_ENABLED": "true",
    "ANALYTICS_ENABLED": "false"
  },
  "previews": {}
}
